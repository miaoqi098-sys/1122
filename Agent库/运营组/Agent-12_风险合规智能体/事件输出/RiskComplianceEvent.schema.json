{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RiskComplianceEvent.schema.json",
  "title": "RiskComplianceEvent",
  "type": "object",
  "required": ["event_id", "agent_id", "event_type", "scope", "marketplace", "observed_at", "severity", "eligibility_status", "confidence", "evidence", "rule_refs"],
  "properties": {
    "event_id": {"type": "string"},
    "agent_id": {"const": "Agent-12"},
    "event_type": {
      "type": "string",
      "enum": ["ACCOUNT_HEALTH_RISK", "LISTING_RESTRICTED_OR_FROZEN", "PRODUCT_COMPLIANCE_GAP", "DANGEROUS_GOODS_RISK", "IP_RISK", "CONTENT_CLAIM_RISK", "REVIEW_POLICY_RISK", "CUSTOMER_SAFETY_RISK", "DOCUMENT_REVIEW_RISK", "PROMOTION_POLICY_RISK", "POLICY_CHANGE_IMPACT", "DATA_QUALITY_RISK"]
    },
    "scope": {"type": "object"},
    "marketplace": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "severity": {"type": "string", "enum": ["info", "low", "medium", "high", "critical"]},
    "eligibility_status": {"type": "string", "enum": ["prohibited", "requires_approval", "requires_more_evidence", "eligible_with_controls", "eligible"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rule_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "required_controls": {"type": "array", "items": {"type": "object"}},
    "remediation_status": {"type": ["string", "null"]},
    "requires_human_approval": {"type": "boolean"},
    "requires_other_agents": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}