  "review_triggers": ["观察窗口结束", "价格/促销变化", "评价结构变化", "主要广告流量结构变化", "竞品页面重大变化", "合规状态变化"],
  "learning_focus": ["消费者内容偏好", "不同页面元素对转化的真实影响", "关键词与页面承接关系", "活动期与常态期转化差异"],
