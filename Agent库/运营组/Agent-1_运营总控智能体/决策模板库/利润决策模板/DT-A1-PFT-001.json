    {"evidence_type": "销量与经营规模", "requirement_level": "required", "freshness_requirement": "与利润窗口一致"},
    {"evidence_type": "历史利润基线", "requirement_level": "preferred", "freshness_requirement": "可比阶段"}
  ],
  "required_agent_inputs": [
    {"agent_id": "Agent-6", "purpose": "利润、成本、盈亏平衡与现金流分析", "requirement_level": "required"},
    {"agent_id": "Agent-4", "purpose": "广告投入变化", "requirement_level": "preferred"},
    {"agent_id": "Agent-7", "purpose": "库存、仓储和补货影响", "requirement_level": "preferred"},
    {"agent_id": "Agent-10", "purpose": "价格与促销成本影响", "requirement_level": "preferred"}
  ],
  "required_constraints": ["最低利润/现金流保护", "安全与可售资格", "库存与仓储成本", "价格与促销约束", "增长目标和投资期限"],
  "key_questions": ["利润变化的主要驱动因素是什么？", "问题是单件经济性恶化还是规模/结构变化？", "哪些成本可控、哪些不可控？", "短期亏损是否有明确增长假设和退出条件？", "不同动作对总利润、单件利润和现金流分别如何影响？"],
  "option_comparison_dimensions": ["单件利润", "贡献利润", "总利润", "现金流", "增长影响", "库存影响", "可逆性", "执行时效", "长期价值"],
  "risk_focus": ["只看毛利忽略其他成本", "只看单件利润错过总利润增长", "短期亏损没有退出条件", "成本口径/时间窗口不一致", "利润优化动作伤害库存或增长", "现金流压力被利润率掩盖"],
  "approval_focus": ["主动接受短期亏损", "大幅增加广告/促销投入", "显著改变价格或采购策略", "突破既定利润/现金流保护线"],
  "task_requirements": ["明确利润口径和时间窗口", "列明可控成本动作", "定义目标利润/现金流变化", "短期亏损策略必须有期限与退出条件", "跨域动作建立任务依赖"],
  "observation_requirements": ["同时观察单件、贡献和总利润", "成本版本变化时重新计算", "增长投入按预设窗口复核回报", "现金流与利润分开监控"],
  "rollback_requirements": ["亏损超出保护边界时停止扩张", "增长假设未验证时缩减投入", "现金流风险升级时优先降低不可逆支出", "利润优化造成核心经营指标恶化时重新生成方案"],
  "review_triggers": ["成本变化", "售价/促销变化", "广告投入变化", "库存/仓储状态变化", "退款率显著变化", "增长投资观察窗口结束"],
  "learning_focus": ["产品真实成本结构", "广告/促销的边际利润", "不同阶段可接受的利润区间", "短期亏损策略的实际回报", "利润与现金流错配模式"],
