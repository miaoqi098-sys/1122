  "trigger_patterns": ["margin_drop", "loss_risk", "cost_increase", "cash_flow_pressure", "break_even_shift", "profit_optimization", "short_term_loss_for_growth"],
  "applicable_states": ["生命周期/经营情境/风险/机会状态引用经营状态识别模块"],
  "exclusion_conditions": ["成本口径不一致且无法校正", "关键成本/售价/广告/促销事实缺失", "问题本质是合规或可售风险且利润仅为次要影响"],
  "required_context": ["当前业务目标与goal_layer", "售价与促销", "产品成本与FBA费用", "广告成本", "仓储/退款/促销等经营成本", "库存状态", "销量和转化", "现金流约束", "历史利润基线"],
  "required_metrics": [
    {"metric_ref": "profit.unit_margin", "purpose": "判断单件经济性", "freshness_requirement": "当前成本/售价版本", "requirement_level": "required"},
    {"metric_ref": "profit.contribution_margin", "purpose": "判断增量经营动作价值", "freshness_requirement": "当前经营窗口", "requirement_level": "required"},
