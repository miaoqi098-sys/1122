    {"metric_ref": "profit.break_even", "purpose": "判断盈亏平衡边界", "freshness_requirement": "当前成本结构", "requirement_level": "preferred"},
    {"metric_ref": "cash_flow.available_or_constraint", "purpose": "约束投入与补货", "freshness_requirement": "当前资金状态", "requirement_level": "preferred"}
  ],
  "required_evidence": [
    {"evidence_type": "售价与成本明细", "requirement_level": "required", "freshness_requirement": "当前版本"},
