  "domain": "profit",
  "description": "用于Agent-1处理利润下降、亏损、成本上升、现金流压力和收益优化问题，并判断广告、价格、促销、库存等动作的经济可行性。",
  "owner_agent": "Agent-1",
  "supported_item_types": ["risk", "problem", "opportunity", "goal_gap", "decision", "investigation"],
