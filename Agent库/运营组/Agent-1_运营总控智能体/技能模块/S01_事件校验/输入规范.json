{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S01 事件校验输入规范",
  "type": "object",
  "required": ["event"],
  "properties": {
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "source_agent",
        "product_id",
        "event_type",
        "severity",
        "occurred_at",
        "summary",
        "facts"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "source_agent": {"type": "string", "minLength": 1},
        "product_id": {"type": "string", "minLength": 1},
        "event_type": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "facts": {"type": "array", "minItems": 1},
        "recommendation": {}
      },
      "additionalProperties": true
    },
    "known_product_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "allowed_sources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "existing_events": {
      "type": "array",
      "items": {"type": "object"}
    },
    "current_time": {
      "type": "string"
    }
  },
  "additionalProperties": true
}