{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S02 上下文装载输出规范 V1.1",
  "type": "object",
  "required": ["skill_id", "event_id", "scope", "status", "question", "context_package", "missing_context", "stale_context", "next_action"],
  "properties": {
    "skill_id": {"const": "S02"},
    "event_id": {"type": "string"},
    "scope": {
      "type": "object",
      "required": ["scope_type"],
      "properties": {
        "scope_type": {"enum": ["product", "parent_product", "sku", "account", "store", "global"]},
        "scope_id": {"type": ["string", "null"]},
        "product_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "status": {"enum": ["ready", "ready_with_gaps", "needs_information", "blocked"]},
    "question": {"type": "string"},
    "context_package": {
      "type": "object",
      "description": "后续Skill的上下文唯一事实源。不得用并列快捷字段建立第二事实源。",
      "properties": {
        "C01_product_identity": {},
        "C02_business_state": {},
        "C03_current_goals": {},
        "C04_core_metrics": {},
        "C05_events_and_promotions": {},
        "C06_product_history": {},
        "C07_agent_analyses": {},
        "C08_market_and_competitors": {},
        "C09_business_knowledge": {},
        "C10_active_tasks_and_constraints": {}
      },
      "additionalProperties": false
    },
    "loaded_items": {"type": "array"},
    "missing_context": {"type": "array"},
    "stale_context": {"type": "array"},
    "excluded_context": {"type": "array"},
    "context_refs": {"type": "array", "items": {"type": "string"}},
    "context_summary": {"type": "string"},
    "next_action": {"enum": ["continue_analysis", "refresh_context", "request_information", "request_agent_analysis", "hold_for_review"]}
  },
  "additionalProperties": true
}