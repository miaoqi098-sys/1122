{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S03 冲突检测输入规范 V1.1",
  "type": "object",
  "required": ["event_id", "product_id", "context_package"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "context_package": {"type": "object"},
    "current_goals": {"type": "object"},
    "active_tasks": {"type": "array"},
    "agent_analyses": {"type": "array"},
    "hard_constraints": {"type": "array"},
    "normalized_elements": {
      "type": "array",
      "description": "可由S02/运行器预先提供，也可由S03内部标准化器生成。",
      "items": {
        "type": "object",
        "required": ["element_id", "element_type", "source", "subject"],
        "properties": {
          "element_id": {"type": "string"},
          "element_type": {
            "enum": ["fact", "analysis", "recommendation", "decision", "task", "constraint", "hypothesis"]
          },
          "source": {"type": "string"},
          "source_agent": {"type": ["string", "null"]},
          "subject": {"type": "string"},
          "topic_or_metric": {"type": ["string", "null"]},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "time_window": {},
          "as_of": {"type": ["string", "null"]},
          "confidence": {"type": ["string", "number", "null"]},
          "goal": {"type": ["string", "null"]},
          "action_direction": {"type": ["string", "null"]},
          "status": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}