{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S10 策略防抖输入规范 V1.2",
  "type": "object",
  "required": ["scope", "proposed_action", "active_or_recent_tasks"],
  "properties": {
    "scope": {
      "type": "object",
      "required": ["scope_type"],
      "properties": {
        "scope_type": {"enum": ["product", "parent_product", "sku", "account", "store", "campaign", "ad_group", "target", "keyword", "task", "decision", "other"]},
        "scope_id": {"type": ["string", "null"]},
        "product_id": {"type": ["string", "null"]},
        "marketplace": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "proposed_action": {
      "type": "object",
      "required": ["target", "action_type", "direction"],
      "properties": {
        "target": {"type": "string"},
        "action_type": {"type": "string"},
        "direction": {"type": "string"},
        "magnitude": {},
        "scope": {},
        "time_horizon": {},
        "reason": {"type": ["string", "null"]},
        "source_decision_id": {"type": ["string", "null"]},
        "source_decision_item_id": {"type": ["string", "null"]},
        "source_option_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "active_or_recent_tasks": {"type": "array"},
    "strategy_chain": {
      "type": "object",
      "properties": {
        "strategy_chain_id": {"type": "string"},
        "decision_ids": {"type": "array", "items": {"type": "string"}},
        "decision_item_id": {"type": ["string", "null"]},
        "target": {"type": ["string", "null"]},
        "original_direction": {"type": ["string", "null"]},
        "current_direction": {"type": ["string", "null"]},
        "started_at": {"type": ["string", "null"]},
        "observation_window": {},
        "adjustment_count": {"type": "integer", "minimum": 0},
        "reversal_count": {"type": "integer", "minimum": 0},
        "last_change_at": {"type": ["string", "null"]},
        "current_status": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "original_evidence": {"type": "object"},
    "new_evidence": {"type": "array"},
    "new_evidence_summary": {"type": "object"},
    "business_state_before": {"type": "object"},
    "business_state": {"type": "object"},
    "state_change": {"type": "object"},
    "guardrail_conditions": {"type": "array"},
    "stop_conditions": {"type": "array"},
    "observation_window": {"type": "object"},
    "current_time": {"type": "string"},
    "permissions": {"type": "object"},
    "approval_context": {"type": "object"}
  },
  "additionalProperties": true
}