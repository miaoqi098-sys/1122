{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S10 策略防抖输出规范 V1.2",
  "type": "object",
  "required": ["skill_id", "stabilization_id", "decision", "change_relation", "signal_class", "evidence_delta", "reason", "next_action"],
  "properties": {
    "skill_id": {"const": "S10"},
    "stabilization_id": {"type": "string", "minLength": 1},
    "strategy_chain_id": {"type": ["string", "null"]},
    "source_decision_id": {"type": ["string", "null"]},
    "source_decision_item_id": {"type": ["string", "null"]},
    "decision": {"enum": ["allow", "hold", "merge", "escalate", "override"]},
    "change_relation": {"enum": ["same_direction", "minor_adjustment", "neutral", "partial_reversal", "full_reversal", "conflicting_action"]},
    "signal_class": {"enum": ["noise", "repeated_signal", "trend", "state_change", "guardrail_trigger", "stop_trigger", "critical_risk"]},
    "evidence_delta": {"enum": ["weaker", "same", "stronger", "critical_new_fact", "unknown"]},
    "matched_tasks": {"type": "array"},
    "observation_remaining": {},
    "triggered_conditions": {"type": "array"},
    "evidence_for_change": {"type": "array"},
    "hold_gate": {"type": ["object", "null"]},
    "override_record": {
      "type": ["object", "null"],
      "properties": {
        "overridden_decision_id": {"type": ["string", "null"]},
        "overridden_task_ids": {"type": "array"},
        "strategy_chain_id": {"type": ["string", "null"]},
        "trigger": {"type": "string"},
        "evidence_refs": {"type": "array"},
        "previous_direction": {"type": ["string", "null"]},
        "new_direction": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "approval_required": {},
        "old_task_actions": {"type": "array"}
      },
      "additionalProperties": true
    },
    "reason": {"type": "string"},
    "review_at": {"type": ["string", "null"]},
    "next_action": {"enum": ["continue_existing_strategy", "merge_into_strategy_chain", "send_to_S07", "send_to_S03", "request_more_context", "request_approval"]}
  },
  "additionalProperties": true
}