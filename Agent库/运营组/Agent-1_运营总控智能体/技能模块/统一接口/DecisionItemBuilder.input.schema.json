{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionItemBuilder Input V1.0",
  "type": "object",
  "required": ["scope", "source_event_refs", "context_package", "conflicts", "conflict_groups"],
  "properties": {
    "scope": {"type": "object"},
    "source_event_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "context_package": {"type": "object", "description": "目标、状态、约束、Agent结论等唯一从ContextPackage读取。"},
    "context_refs": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array"},
    "conflict_groups": {"type": "array"},
    "builder_policy": {
      "type": "object",
      "properties": {
        "merge_same_root_problem": {"type": "boolean", "default": true},
        "allow_multiple_items_per_event": {"type": "boolean", "default": true},
        "require_objective_from_context": {"type": "boolean", "default": true}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}