{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent-3 CompetitorSnapshot V1.0",
  "type": "object",
  "required": ["snapshot_id", "competitor_entity_id", "entity_type", "entity_ref", "marketplace", "observed_at", "source_refs", "facts", "comparison_eligible"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "competitor_entity_id": {"type": "string", "minLength": 1},
    "entity_type": {"enum": ["asin", "parent_product", "brand"]},
    "entity_ref": {"type": "string", "minLength": 1},
    "marketplace": {"type": "string", "minLength": 1},
    "our_scope_refs": {"type": "array", "items": {"type": "string"}},
    "relationship_types": {"type": "array", "items": {"enum": ["direct_competitor", "substitute", "price_anchor", "traffic_competitor", "feature_benchmark", "new_entrant_watch", "brand_watch", "other_watch"]}},
    "observed_at": {"type": "string", "format": "date-time"},
    "data_window": {"type": ["string", "null"]},
    "facts": {"type": "object", "additionalProperties": true},
    "search_contexts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_types": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "freshness": {"type": ["string", "null"]},
    "comparison_eligible": {"type": "boolean"},
    "comparison_blockers": {"type": "array", "items": {"type": "string"}},
    "missing_data": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
