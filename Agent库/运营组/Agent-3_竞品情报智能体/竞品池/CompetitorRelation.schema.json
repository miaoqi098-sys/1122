{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent-3 CompetitorRelation V1.0",
  "type": "object",
  "required": ["relation_id", "competitor_entity_id", "entity_type", "entity_ref", "marketplace", "our_scope_refs", "relationship_types", "status", "relationship_evidence", "first_added_at", "last_reviewed_at"],
  "properties": {
    "relation_id": {"type": "string", "minLength": 1},
    "competitor_entity_id": {"type": "string", "minLength": 1},
    "entity_type": {"enum": ["asin", "parent_product", "brand"]},
    "entity_ref": {"type": "string", "minLength": 1},
    "marketplace": {"type": "string", "minLength": 1},
    "our_scope_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "relationship_types": {"type": "array", "minItems": 1, "items": {"enum": ["direct_competitor", "substitute", "price_anchor", "traffic_competitor", "feature_benchmark", "new_entrant_watch", "brand_watch", "other_watch"]}},
    "relationship_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "watch_priority": {"enum": ["high", "medium", "low"]},
    "status": {"enum": ["candidate", "active", "downgraded", "removed"]},
    "first_added_at": {"type": "string", "format": "date-time"},
    "last_reviewed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
