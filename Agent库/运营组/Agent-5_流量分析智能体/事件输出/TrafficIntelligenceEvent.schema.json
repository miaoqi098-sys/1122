{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TrafficIntelligenceEvent.schema.json",
  "title": "TrafficIntelligenceEvent",
  "type": "object",
  "required": ["event_id", "source_agent", "event_type", "scope", "severity", "confidence", "status", "current_window", "evidence_refs", "generated_at"],
  "properties": {
    "event_id": {"type": "string"},
    "source_agent": {"const": "Agent-5"},
    "event_type": {"type": "string"},
    "scope": {"type": "object"},
    "affected_sources": {"type": "array", "items": {"type": "string"}},
    "affected_queries": {"type": "array", "items": {"type": "string"}},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "status": {"enum": ["observed", "suspected", "confirmed", "recovering", "resolved", "closed_as_false_positive"]},
    "current_window": {"type": "object"},
    "baseline_window": {"type": ["object", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metric_deltas": {"type": "array", "items": {"type": "object"}},
    "cause_candidates": {"type": "array", "items": {"type": "object"}},
    "cross_agent_requests": {"type": "array", "items": {"type": "object"}},
    "data_quality": {"type": "object"},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}