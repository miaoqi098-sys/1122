{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FinancialAnalysisResponse.schema.json",
  "title": "FinancialAnalysisResponse",
  "type": "object",
  "required": ["response_id", "agent_id", "request_ref", "scope", "status", "summary", "evidence_refs", "confidence"],
  "properties": {
    "response_id": {"type": "string"},
    "agent_id": {"const": "Agent-6"},
    "request_ref": {"type": "string"},
    "scope": {"type": "object"},
    "status": {"type": "string", "enum": ["completed", "partial", "needs_information", "blocked"]},
    "summary": {"type": "string"},
    "financial_metrics": {"type": "array", "items": {"type": "object"}},
    "constraint_findings": {"type": "array", "items": {"type": "object"}},
    "scenario_results": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "opportunities": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "recommended_agent_requests": {"type": "array", "items": {"type": "object"}},
    "decision_boundary": {"const": "advisory_only"}
  },
  "additionalProperties": false
}