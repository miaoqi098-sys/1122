{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "InventorySupplyResponse.schema.json",
  "title": "InventorySupplyResponse",
  "type": "object",
  "required": ["response_id", "agent_id", "request_ref", "scope", "status", "summary", "confidence", "evidence_refs"],
  "properties": {
    "response_id": {"type": "string"},
    "agent_id": {"const": "Agent-7"},
    "request_ref": {"type": "string"},
    "scope": {"type": "object"},
    "status": {"type": "string", "enum": ["completed", "partial", "needs_information", "blocked"]},
    "summary": {"type": "string"},
    "inventory_metrics": {"type": "array", "items": {"type": "object"}},
    "replenishment_assessment": {"type": ["object", "null"]},
    "supply_risks": {"type": "array", "items": {"type": "object"}},
    "demand_assumptions": {"type": "array", "items": {"type": "object"}},
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "recommended_agent_requests": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "decision_boundary": {"const": "advisory_only"}
  },
  "additionalProperties": false
}