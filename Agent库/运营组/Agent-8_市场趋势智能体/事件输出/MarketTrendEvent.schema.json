{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MarketTrendEvent.schema.json",
  "title": "MarketTrendEvent",
  "type": "object",
  "required": ["event_id", "agent_id", "trend_type", "subject", "scope", "observed_at", "direction", "status", "confidence", "supporting_signals"],
  "properties": {
    "event_id": {"type": "string"},
    "agent_id": {"const": "Agent-8"},
    "trend_type": {"type": "string", "enum": ["EMERGING_UPTREND", "CONFIRMED_UPTREND", "EMERGING_DOWNTREND", "CONFIRMED_DOWNTREND", "SEASONAL_RISE", "SEASONAL_COOLDOWN", "STRUCTURAL_SHIFT", "EVENT_DRIVEN_SPIKE", "EVENT_DRIVEN_DROP", "NOISY_SIGNAL"]},
    "subject": {"type": "string"},
    "scope": {"type": "object"},
    "observed_at": {"type": "string", "format": "date-time"},
    "direction": {"type": "string", "enum": ["up", "down", "mixed", "stable", "unknown"]},
    "status": {"type": "string", "enum": ["candidate", "confirmed", "persistent", "weakening", "event_driven", "ended"]},
    "strength": {"type": ["number", "null"], "minimum": 0},
    "persistence": {"type": ["number", "null"], "minimum": 0},
    "breadth": {"type": ["number", "null"], "minimum": 0},
    "seasonality_flag": {"type": "boolean"},
    "event_driver": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "supporting_signals": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "conflicting_signals": {"type": "array", "items": {"type": "object"}},
    "potential_impacts": {"type": "array", "items": {"type": "object"}},
    "requires_other_agents": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}