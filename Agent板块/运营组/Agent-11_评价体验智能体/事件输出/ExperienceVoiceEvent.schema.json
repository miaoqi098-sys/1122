{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ExperienceVoiceEvent.schema.json",
  "title": "ExperienceVoiceEvent",
  "type": "object",
  "required": ["event_id", "agent_id", "event_type", "scope", "observed_at", "severity", "confidence", "evidence"],
  "properties": {
    "event_id": {"type": "string"},
    "agent_id": {"const": "Agent-11"},
    "event_type": {
      "type": "string",
      "enum": ["RATING_DROP", "NEGATIVE_REVIEW_SURGE", "NEW_VOC_THEME", "VOC_THEME_WORSENING", "RETURN_RATE_SPIKE", "REFUND_REASON_SHIFT", "VARIATION_EXPERIENCE_GAP", "EXPECTATION_MISMATCH", "SAFETY_EXPERIENCE_SIGNAL", "REVIEW_ANOMALY_SIGNAL", "EXPERIENCE_IMPROVEMENT", "DATA_QUALITY_RISK"]
    },
    "scope": {"type": "object"},
    "observed_at": {"type": "string", "format": "date-time"},
    "severity": {"type": "string", "enum": ["info", "low", "medium", "high", "critical"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rating_context": {"type": ["object", "null"]},
    "voc_themes": {"type": "array", "items": {"type": "object"}},
    "return_refund_context": {"type": ["object", "null"]},
    "anomaly_signals": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "requires_agent_12_review": {"type": "boolean"},
    "requires_other_agents": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}