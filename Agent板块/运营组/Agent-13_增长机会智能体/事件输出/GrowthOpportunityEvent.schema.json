{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GrowthOpportunityEvent.schema.json",
  "title": "GrowthOpportunityEvent",
  "type": "object",
  "required": ["event_id", "agent_id", "opportunity_type", "scope", "observed_at", "status", "hypothesis", "confidence", "evidence_refs", "constraint_status"],
  "properties": {
    "event_id": {"type": "string"},
    "agent_id": {"const": "Agent-13"},
    "opportunity_type": {"type": "string", "enum": ["TRAFFIC_EXPANSION", "ADVERTISING_EFFICIENCY", "CONVERSION_LIFT", "PRICING_PROMOTION", "MARKET_TREND", "INVENTORY_UTILIZATION", "MARGIN_EXPANSION", "EXPERIENCE_RECOVERY", "CROSS_DOMAIN_SYNERGY", "OTHER_VALIDATABLE_GROWTH"]},
    "scope": {"type": "object"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["candidate", "evidence_gathering", "qualified", "proposed", "testing", "validated", "rejected", "inconclusive", "scaled", "closed"]},
    "hypothesis": {"type": "string"},
    "expected_impact": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "feasibility": {"type": ["number", "null"], "minimum": 0},
    "urgency": {"type": ["number", "null"], "minimum": 0},
    "effort": {"type": ["number", "null"], "minimum": 0},
    "constraint_status": {"type": "string", "enum": ["clear", "soft_constraint", "hard_constraint", "unknown_requires_evidence"]},
    "constraints": {"type": "array", "items": {"type": "object"}},
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "validation_plan": {"type": ["object", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_agent_refs": {"type": "array", "items": {"type": "string"}},
    "invalidation_conditions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}