{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent-1 DecisionTemplate Governance Schema V1.0",
  "type": "object",
  "required": [
    "template_id",
    "template_name",
    "template_version",
    "template_status",
    "domain",
    "description",
    "owner_agent",
    "supported_item_types",
    "supported_scopes",
    "required_context",
    "required_evidence",
    "key_questions",
    "option_comparison_dimensions",
    "risk_focus",
    "task_requirements",
    "observation_requirements",
    "rollback_requirements"
  ],
  "properties": {
    "template_id": {"type": "string", "minLength": 1},
    "template_name": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "template_status": {"enum": ["draft", "active", "deprecated", "retired"]},
    "domain": {
      "enum": [
        "advertising",
        "inventory",
        "pricing_promotion",
        "profit",
        "listing_conversion",
        "risk_compliance",
        "review_experience",
        "competitor_market",
        "multi_agent_conflict",
        "integrated_business",
        "other"
      ]
    },
    "description": {"type": "string", "minLength": 1},
    "owner_agent": {"const": "Agent-1"},
    "supported_item_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["risk", "problem", "opportunity", "goal_gap", "decision", "investigation"]}
    },
    "supported_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["account", "store", "global", "parent_product", "product", "sku", "campaign", "ad_group", "keyword", "task", "decision", "other"]
      }
    },
    "trigger_patterns": {"type": "array", "items": {"type": "string"}},
    "applicable_states": {"type": "array", "items": {"type": "string"}},
    "exclusion_conditions": {"type": "array", "items": {"type": "string"}},
    "required_context": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_ref", "purpose"],
        "properties": {
          "metric_ref": {"type": "string"},
          "purpose": {"type": "string"},
          "freshness_requirement": {"type": ["string", "null"]},
          "requirement_level": {"enum": ["required", "preferred", "optional"]}
        },
        "additionalProperties": true
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_type", "requirement_level"],
        "properties": {
          "evidence_type": {"type": "string"},
          "requirement_level": {"enum": ["required", "preferred", "optional"]},
          "freshness_requirement": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "required_agent_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent_id", "purpose"],
        "properties": {
          "agent_id": {"type": "string"},
          "purpose": {"type": "string"},
          "requirement_level": {"enum": ["required", "preferred", "optional"]}
        },
        "additionalProperties": true
      }
    },
    "required_constraints": {"type": "array", "items": {"type": "string"}},
    "key_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "option_comparison_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk_focus": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "approval_focus": {"type": "array", "items": {"type": "string"}},
    "task_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observation_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "review_triggers": {"type": "array", "items": {"type": "string"}},
    "learning_focus": {"type": "array", "items": {"type": "string"}},
    "supersedes": {
      "type": ["object", "null"],
      "properties": {
        "template_id": {"type": "string"},
        "template_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "canonical_refs": {
      "type": "object",
      "properties": {
        "decision_item_schema": {"type": "string"},
        "decision_selector_input_schema": {"type": "string"},
        "final_decision_schema": {"type": "string"}
      },
      "additionalProperties": true
    },
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}