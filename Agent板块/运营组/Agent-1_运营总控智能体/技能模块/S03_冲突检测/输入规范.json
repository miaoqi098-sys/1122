{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S03 冲突检测输入规范 V1.2",
  "type": "object",
  "required": ["event_id", "scope", "context_package"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["scope_type"],
      "properties": {
        "scope_type": {"enum": ["product", "parent_product", "sku", "account", "store", "global"]},
        "scope_id": {"type": ["string", "null"]},
        "product_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "context_package": {"type": "object", "description": "唯一权威上下文来源，直接承接S02.context_package。"},
    "context_refs": {"type": "array", "items": {"type": "string"}},
    "normalized_elements": {
      "type": "array",
      "description": "可由运行器从context_package派生，也可由S03内部生成；属于派生视图，不得覆盖context_package原始语义。",
      "items": {
        "type": "object",
        "required": ["element_id", "element_type", "source", "subject"],
        "properties": {
          "element_id": {"type": "string"},
          "element_type": {"enum": ["fact", "analysis", "recommendation", "decision", "task", "constraint", "hypothesis"]},
          "source": {"type": "string"},
          "source_agent": {"type": ["string", "null"]},
          "subject": {"type": "string"},
          "topic_or_metric": {"type": ["string", "null"]},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "time_window": {},
          "as_of": {"type": ["string", "null"]},
          "confidence": {"type": ["string", "number", "null"]},
          "goal": {"type": ["string", "null"]},
          "action_direction": {"type": ["string", "null"]},
          "status": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}