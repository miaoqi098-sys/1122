{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S05 方案生成输入规范 V1.2",
  "type": "object",
  "required": ["scope", "decision_item", "context_package"],
  "properties": {
    "scope": {"type": "object"},
    "decision_item": {
      "type": "object",
      "required": ["decision_item_id", "problem_definition", "objective", "business_priority", "goal_layer", "priority_basis"],
      "properties": {
        "decision_item_id": {"type": "string"},
        "problem_definition": {"type": "string"},
        "objective": {"type": "string"},
        "business_priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "goal_layer": {"enum": ["safety_sellability", "survival_operations", "business_quality", "growth_expansion", "unknown"]},
        "priority_basis": {"type": "string"},
        "conflict_refs": {"type": "array", "items": {"type": "string"}},
        "constraint_refs": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "context_package": {"type": "object", "description": "唯一权威上下文来源，直接承接S02。"},
    "generation_policy": {
      "type": "object",
      "properties": {
        "min_options": {"type": "integer", "minimum": 1},
        "max_options": {"type": "integer", "minimum": 1},
        "allow_observe": {"type": "boolean"},
        "allow_information_first": {"type": "boolean"},
        "prefer_reversible_when_uncertain": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}