{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S07 任务编排输出规范 V1.2",
  "type": "object",
  "required": ["skill_id", "task_plan_id", "decision_id", "decision_item_id", "tasks", "task_graph", "next_action"],
  "properties": {
    "skill_id": {"const": "S07"},
    "task_plan_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string"},
    "decision_item_id": {"type": "string"},
    "strategy_chain_id": {"type": ["string", "null"]},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "task_plan_id", "decision_id", "decision_item_id", "task_type", "owner", "executor", "action", "business_priority", "approval_level", "success_criteria", "stop_conditions", "validator", "status"],
        "properties": {
          "task_id": {"type": "string"},
          "task_plan_id": {"type": "string"},
          "decision_id": {"type": "string"},
          "decision_item_id": {"type": "string"},
          "option_id": {"type": ["string", "null"]},
          "strategy_chain_id": {"type": ["string", "null"]},
          "source_action_id": {"type": ["string", "null"]},
          "scope": {"type": "object"},
          "task_type": {"enum": ["execution", "monitoring", "approval", "data_collection", "validation", "control", "rollback"]},
          "owner": {"type": "string"},
          "executor": {"type": "string"},
          "approver": {"type": ["string", "null"]},
          "validator": {"type": "string"},
          "action": {"type": "object"},
          "business_priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "blocks": {"type": "array", "items": {"type": "string"}},
          "parallel_with": {"type": "array", "items": {"type": "string"}},
          "mutex_with": {"type": "array", "items": {"type": "string"}},
          "approval_level": {"type": "string"},
          "start_condition": {},
          "deadline_or_window": {},
          "success_criteria": {"type": "array"},
          "stop_conditions": {"type": "array"},
          "rollback": {},
          "required_controls": {"type": "array"},
          "status": {"enum": ["created", "pending_approval", "ready", "running", "blocked", "failed", "cancelled", "awaiting_validation", "completed", "rolled_back"]},
          "blocked_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "task_graph": {"type": "object"},
    "unresolved_dependencies": {"type": "array"},
    "orchestration_notes": {"type": "array"},
    "next_action": {"enum": ["send_to_scheduler", "request_approval", "resolve_dependency", "request_more_information", "reject_plan"]}
  },
  "additionalProperties": true
}