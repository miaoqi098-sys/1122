{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionSelector Output V1.0",
  "type": "object",
  "required": ["selector_id", "final_decision", "next_action"],
  "properties": {
    "selector_id": {"type": "string", "minLength": 1},
    "final_decision": {
      "type": "object",
      "required": ["decision_id", "decision_item_id", "business_priority", "selected_option", "risk_assessment", "decision_basis", "created_at"],
      "properties": {
        "decision_id": {"type": "string"},
        "decision_item_id": {"type": "string"},
        "business_priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "selected_option": {"type": "object"},
        "risk_assessment": {"type": "object"},
        "decision_basis": {
          "type": "object",
          "required": ["why_selected", "why_not_others"],
          "properties": {
            "why_selected": {"type": "string"},
            "why_not_others": {"type": "array"},
            "goal_alignment": {"type": "array"},
            "state_alignment": {"type": "array"},
            "conflict_refs": {"type": "array", "items": {"type": "string"}},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "knowledge_refs": {"type": "array", "items": {"type": "string"}},
            "historical_refs": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "approval": {"type": "object"},
        "strategy_chain_id": {"type": ["string", "null"]},
        "supersedes_decision_id": {"type": ["string", "null"]},
        "rollback_reference": {"type": ["string", "null"]},
        "decision_confidence": {"enum": ["high", "medium", "low"]},
        "created_at": {"type": "string"},
        "valid_until": {"type": ["string", "null"]},
        "review_trigger": {"type": "array"}
      },
      "additionalProperties": true
    },
    "rejected_option_ids": {"type": "array", "items": {"type": "string"}},
    "selection_notes": {"type": "array"},
    "next_action": {"enum": ["continue_to_S07", "send_to_S10", "request_more_evidence", "regenerate_options", "request_approval_context", "hold_for_review"]}
  },
  "additionalProperties": true
}