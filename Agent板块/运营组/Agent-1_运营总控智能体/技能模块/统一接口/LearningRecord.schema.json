{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical LearningRecord V1.0",
  "type": "object",
  "required": ["learning_id", "validation_id", "level", "learning_action", "statement", "confidence", "promotion_gate"],
  "properties": {
    "learning_id": {"type": "string", "minLength": 1},
    "learning_batch_id": {"type": ["string", "null"]},
    "validation_id": {"type": "string", "minLength": 1},
    "execution_result_id": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "decision_id": {"type": ["string", "null"]},
    "decision_item_id": {"type": ["string", "null"]},
    "option_id": {"type": ["string", "null"]},
    "strategy_chain_id": {"type": ["string", "null"]},
    "scope": {"type": "object"},
    "level": {"enum": ["observation", "product_lesson", "reusable_pattern", "knowledge_candidate", "validated_knowledge"]},
    "learning_action": {"enum": ["record_fact", "create_lesson", "promote", "merge", "refine", "deprecate", "hold"]},
    "statement": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_quality": {"enum": ["high", "medium", "low", "unknown"]},
    "attribution_strength": {"enum": ["strong", "moderate", "weak", "confounded", "not_evaluable"]},
    "applicability": {"type": "array"},
    "invalid_when": {"type": "array"},
    "confidence": {"enum": ["low", "medium", "high"]},
    "support_count": {"type": "integer", "minimum": 0},
    "contradiction_count": {"type": "integer", "minimum": 0},
    "relationships": {"type": "array"},
    "knowledge_domain": {"type": ["string", "null"]},
    "version": {"type": ["string", "integer"]},
    "promotion_gate": {"enum": ["eligible", "hold", "needs_more_evidence", "conflicted", "rejected"]},
    "created_at": {"type": ["string", "null"]},
    "last_validated_at": {"type": ["string", "null"]},
    "valid_until": {"type": ["string", "null"]},
    "review_trigger": {"type": "array"}
  },
  "additionalProperties": true
}