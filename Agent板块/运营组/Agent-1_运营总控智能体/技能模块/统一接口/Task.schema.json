{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Task V1.0",
  "type": "object",
  "required": ["task_id", "task_plan_id", "decision_id", "decision_item_id", "task_type", "action", "owner", "executor", "validator", "status"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "task_plan_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_item_id": {"type": "string", "minLength": 1},
    "option_id": {"type": ["string", "null"]},
    "strategy_chain_id": {"type": ["string", "null"]},
    "source_action_id": {"type": ["string", "null"]},
    "scope": {"type": "object"},
    "task_type": {"enum": ["execution", "monitoring", "approval", "data_collection", "validation", "control", "rollback"]},
    "action": {"type": "object"},
    "owner": {"type": "string"},
    "executor": {"type": "string"},
    "approver": {"type": ["string", "null"]},
    "validator": {"type": "string"},
    "business_priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "blocks": {"type": "array", "items": {"type": "string"}},
    "parallel_with": {"type": "array", "items": {"type": "string"}},
    "mutex_with": {"type": "array", "items": {"type": "string"}},
    "approval_level": {"type": ["string", "null"]},
    "start_condition": {},
    "deadline_or_window": {},
    "success_criteria": {"type": "array"},
    "stop_conditions": {"type": "array"},
    "rollback": {},
    "required_controls": {"type": "array"},
    "status": {"enum": ["created", "pending_approval", "ready", "running", "blocked", "failed", "cancelled", "awaiting_validation", "completed", "rolled_back"]},
    "created_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}