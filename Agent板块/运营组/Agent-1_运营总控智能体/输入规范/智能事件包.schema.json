{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent-1 标准智能事件包 V1.1",
  "type": "object",
  "required": ["event_id", "source_type", "event_type", "scope_type", "severity", "occurred_at", "summary", "facts"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["professional_agent", "system", "human", "external"]},
    "source_agent": {"type": ["string", "null"], "pattern": "^Agent-(?:[2-9]|1[0-3])$"},
    "source_actor": {"type": ["string", "null"]},
    "source_ref": {"type": ["string", "null"]},
    "event_type": {"type": "string", "minLength": 1},
    "scope_type": {"enum": ["product", "parent_product", "sku", "account", "store", "global"]},
    "scope_id": {"type": ["string", "null"]},
    "scope_objects": {"type": "array", "items": {"type": "object"}},
    "product_id": {"type": ["string", "null"]},
    "asin": {"type": ["string", "null"]},
    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": ["string", "null"], "format": "date-time"},
    "summary": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metrics": {"type": "object", "additionalProperties": true},
    "recommendation": {"type": ["string", "null"], "description": "可选建议，不是S01硬必填事实。"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "related_events": {"type": "array", "items": {"type": "string"}},
    "parent_event_id": {"type": ["string", "null"]},
    "requires_decision_by": {"type": ["string", "null"], "format": "date-time"},
    "data_window": {"type": ["string", "null"]},
    "attachments": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {
      "if": {"properties": {"source_type": {"const": "professional_agent"}}},
      "then": {"required": ["source_agent"]}
    },
    {
      "if": {"properties": {"scope_type": {"enum": ["product", "parent_product", "sku"]}}},
      "then": {"required": ["product_id"], "properties": {"product_id": {"type": "string", "minLength": 1}}}
    }
  ],
  "additionalProperties": false
}
