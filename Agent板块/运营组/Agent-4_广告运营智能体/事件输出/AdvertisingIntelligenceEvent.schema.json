{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AdvertisingIntelligenceEvent.schema.json",
  "title": "AdvertisingIntelligenceEvent",
  "type": "object",
  "required": ["event_id", "source_agent", "event_type", "scope", "affected_entities", "severity", "confidence", "status", "current_window", "evidence_refs", "generated_at"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "source_agent": {"const": "Agent-4"},
    "event_type": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["scope_type", "scope_id"],
      "properties": {
        "scope_type": {"type": "string"},
        "scope_id": {"type": "string"},
        "marketplace": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "affected_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entity_type", "entity_id"],
        "properties": {
          "entity_type": {"enum": ["portfolio", "campaign", "ad_group", "ad", "target", "search_term", "product"]},
          "entity_id": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "status": {"enum": ["observed", "suspected", "confirmed", "recovering", "resolved", "closed_as_false_positive"]},
    "current_window": {"type": "object"},
    "baseline_window": {"type": ["object", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metric_deltas": {"type": "array", "items": {"type": "object"}},
    "diagnosis": {"type": ["object", "null"]},
    "recommendation_candidates": {"type": "array", "items": {"type": "object"}},
    "cross_agent_requests": {"type": "array", "items": {"type": "object"}},
    "strategy_chain_id": {"type": ["string", "null"]},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}