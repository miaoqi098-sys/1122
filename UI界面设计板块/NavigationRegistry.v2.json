    "version": "2.1.0",
    "home_module": {
      "id": "command-center",
      "name_cn": "经营指挥中心",
      "route": "/command-center",
      "source_path": "web-console/index.html",
      "ui": {
        "icon": "◈",
        "kind": "dashboard",
        "nav_group": "overview",
        "readiness": "LIVE_READ",
        "summary": "统一查看经营、数据和连接健康状态。",
        "legacy_source": "index.html"
      }
    },
    "module_metadata": {
      "selection": { "icon": "◉", "kind": "module", "nav_group": "business", "readiness": "DESIGN_ONLY", "summary": "市场机会、容量、竞争、利润与新品机会评估。" },
      "operations": { "icon": "▦", "kind": "group", "nav_group": "business", "readiness": "PARTIAL_LIVE", "summary": "产品、广告、库存、竞品与站外经营。" },
      "products": { "kind": "module", "readiness": "LIVE_READ", "summary": "产品状态、流量转化、价格、利润与体验。" },
      "inventory-logistics": { "kind": "module", "readiness": "PARTIAL_LIVE", "summary": "库存覆盖、在途与 FBA 只读状态。", "connectors": ["amazon-sp-api"] },
      "offsite": { "kind": "module", "readiness": "DESIGN_ONLY", "summary": "站外渠道、红人合作、活动与归因。", "legacy_source": "运营板块/站外推广板块/01_品牌官网与独立站/01_API资质官网/site/index.html" },
      "competitors": { "kind": "module", "readiness": "PARTIAL_LIVE", "summary": "竞品池、SIF 流量词、去重词库、分类与市场信号。", "connectors": ["sif"] },
      "competitor-keywords": { "kind": "module", "readiness": "PARTIAL_LIVE", "summary": "批量 ASIN → SIF 分页流量词 → 严格去重 → 10 类分类 → D1 可追溯词库。", "connectors": ["sif"] },
      "ads": { "kind": "module", "readiness": "PARTIAL_LIVE", "summary": "Amazon Ads 的实时 Profiles、Campaigns、Ad Groups，以及人工确认的 Campaign 状态切换。", "connectors": ["amazon-ads"] },
      "sandbox": { "icon": "◇", "kind": "module", "nav_group": "automation", "readiness": "DESIGN_ONLY", "summary": "经营情景、反事实基线和策略推演。" },
      "internal-policy": { "icon": "⌘", "kind": "module", "nav_group": "system", "readiness": "CONTRACT_READY", "summary": "权限、审批、自动化、安全和 fail-closed 规则。" },
      "amazon-boundary": { "icon": "◎", "kind": "boundary", "nav_group": "intelligence", "readiness": "LIVE_READ", "summary": "APR、AOM 与 APB 的证据化入口。" },
      "apr": { "kind": "boundary", "readiness": "LIVE_READ", "summary": "市场现象与边界信号。" },
      "aom": { "kind": "boundary", "readiness": "LIVE_READ", "summary": "合规运营方法库。" },
      "apb": { "kind": "boundary", "readiness": "LIVE_READ", "summary": "政策证据和边界结论。" },
      "agents": { "icon": "✦", "kind": "module", "nav_group": "automation", "readiness": "PARTIAL_LIVE", "summary": "运营总控与专业 Agent 的状态、输入与受控工作流。", "connectors": ["codex"] },
      "skills": { "icon": "⌁", "kind": "module", "nav_group": "system", "readiness": "CONTRACT_READY", "summary": "可复用能力、工具契约和权限边界。" },
      "connectors": { "icon": "⇄", "kind": "connectors", "nav_group": "system", "readiness": "PARTIAL_LIVE", "summary": "Amazon、SIF、Cloudflare、Email、Codex 的统一健康状态。" },
      "amazon-sp-api-console": { "kind": "connector", "readiness": "LIVE_READ", "summary": "Amazon SP-API 的只读健康状态与安全接入边界。", "connectors": ["amazon-sp-api"], "legacy_source": "amazon-sp-api.html" },
      "amazon-ads-console": { "kind": "connector", "readiness": "PARTIAL_LIVE", "summary": "Amazon Ads OAuth、Profiles、读取状态与受控 Campaign 写入门禁。", "connectors": ["amazon-ads"] },
      "tasks": { "icon": "☑", "kind": "module", "nav_group": "automation", "readiness": "LIVE_EMPTY", "summary": "Decision、Approval、Permission 与 Outcome 的受控链路。" },
      "knowledge": { "icon": "◇", "kind": "module", "nav_group": "intelligence", "readiness": "LIVE_READ", "summary": "可复用经营知识、规则、方法与经验。" },
      "memory": { "icon": "◫", "kind": "module", "nav_group": "system", "readiness": "CONTRACT_READY", "summary": "产品、任务、决策、结果与经营历史。" },
      "data": { "icon": "▤", "kind": "module", "nav_group": "system", "readiness": "LIVE_READ", "summary": "HOT、WARM、COLD 事实层、数据质量与来源追溯。" },
      "ui-design": { "kind": "support", "nav_group": "support", "readiness": "CONTRACT_READY", "summary": "导航、路由、读模型与页面契约。" },
      "conflicts": { "kind": "support", "nav_group": "support", "readiness": "TRACKED", "summary": "跨模块问题登记、修复与验证闭环。" },
      "system-overview": { "kind": "support", "nav_group": "support", "readiness": "LIVE_READ", "summary": "GitHub 架构盘点与 Cloudflare 资源概览。" }
    },
