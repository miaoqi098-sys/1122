{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AmazonPolicyBoundaryView V1",
  "type":"object",
  "additionalProperties":false,
  "required":["generated_at","marketplace","domain_cards","result_rows","view_status"],
  "properties":{
    "generated_at":{"type":"string","format":"date-time"},
    "marketplace":{"type":"string"},
    "summary":{"type":"object","properties":{
      "domain_total":{"type":"integer","const":18},
      "verified_count":{"type":"integer","minimum":0},
      "seeded_count":{"type":"integer","minimum":0},
      "discovery_count":{"type":"integer","minimum":0},
      "conflict_count":{"type":"integer","minimum":0},
      "policy_diff_count":{"type":"integer","minimum":0},
      "boundary_signal_count":{"type":"integer","minimum":0},
      "confirmed_result_count":{"type":"integer","minimum":0}
    },"additionalProperties":false},
    "domain_cards":{"type":"array","minItems":18,"maxItems":18,"items":{"type":"object","required":["domain_no","domain_code","name_cn","coverage_status"],"properties":{
      "domain_no":{"type":"string","pattern":"^(0[1-9]|1[0-8])$"},
      "domain_code":{"type":"string"},
      "name_cn":{"type":"string"},
      "coverage_status":{"enum":["DISCOVERY","SEEDED","VERIFIED","CONFLICT","UNKNOWN"]},
      "policy_evidence_count":{"type":"integer","minimum":0},
      "policy_diff_count":{"type":"integer","minimum":0},
      "signal_count":{"type":"integer","minimum":0},
      "candidate_count":{"type":"integer","minimum":0},
      "confirmed_count":{"type":"integer","minimum":0},
      "last_verified_at":{"type":["string","null"]}
    },"additionalProperties":false}},
    "result_rows":{"type":"array","items":{"type":"object","required":["case_id","domain_no","result_type","status","confidence","updated_at"],"properties":{
      "case_id":{"type":"string"},
      "domain_no":{"type":"string"},
      "domain_name_cn":{"type":"string"},
      "marketplace":{"type":"string"},
      "result_type":{"enum":["POLICY_EVIDENCE","POLICY_DIFF","BOUNDARY_SIGNAL","BOUNDARY_CANDIDATE","CONFIRMED_BOUNDARY_RESULT","PRODUCT_IMPACT"]},
      "status":{"type":"string"},
      "title_cn":{"type":["string","null"]},
      "summary_cn":{"type":["string","null"]},
      "confidence":{"enum":["HIGH","MEDIUM","LOW","UNVERIFIED"]},
      "affected_product_count":{"type":"integer","minimum":0},
      "last_verified_at":{"type":["string","null"]},
      "updated_at":{"type":"string"},
      "evidence_count":{"type":"integer","minimum":0}
    },"additionalProperties":false}},
    "policy_change_feed":{"type":"array","items":{"type":"object"}},
    "product_impacts":{"type":"array","items":{"type":"object"}},
    "section_status":{"type":"object"},
    "view_status":{"enum":["complete","degraded","unavailable"]},
    "execution_authorized":{"const":false}
  }
}
