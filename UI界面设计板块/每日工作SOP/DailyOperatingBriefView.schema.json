{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DailyOperatingBriefView V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "view_status",
    "daily_brief_source_status",
    "product_facts",
    "daily_briefs",
    "read_only",
    "execution_authorized",
    "production_write_authorized"
  ],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "view_status": { "enum": ["complete", "degraded", "unavailable"] },
    "daily_brief_source_status": { "enum": ["LIVE_D1_READ", "NOT_INGESTED", "UNAVAILABLE", "READ_ERROR"] },
    "product_facts": { "type": "array", "items": { "type": "object" } },
    "daily_briefs": {
      "type": "array",
      "items": { "$ref": "../../运营板块/每日工作SOP/daily-ops.schema.json" }
    },
    "task_facts": { "type": "array", "items": { "type": "object" } },
    "missing_sections": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "read_only": { "const": true },
    "execution_authorized": { "const": false },
    "production_write_authorized": { "const": false }
  }
}
