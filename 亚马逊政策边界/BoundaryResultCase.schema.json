{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AmazonBoundaryResultCase",
  "type":"object",
  "additionalProperties":false,
  "required":["case_id","domain_no","domain","marketplace","result_type","status","expected_state","observed_state","confidence","updated_at","execution_authorized"],
  "properties":{
    "case_id":{"type":"string","pattern":"^APB-(0[1-9]|1[0-8])-(PE|PD|BS|BC|BR|PI)-[0-9]{4}$"},
    "domain_no":{"type":"string","pattern":"^(0[1-9]|1[0-8])$"},
    "domain":{"type":"string"},
    "subdomain":{"type":["string","null"]},
    "marketplace":{"type":"string"},
    "result_type":{"enum":["POLICY_EVIDENCE","POLICY_DIFF","BOUNDARY_SIGNAL","BOUNDARY_CANDIDATE","CONFIRMED_BOUNDARY_RESULT","PRODUCT_IMPACT"]},
    "status":{"enum":["DISCOVERY","SEEDED","VERIFIED","OBSERVATION","NEEDS_RECHECK","SIGNAL","CANDIDATE","CONFIRMED","CONFLICT","UNKNOWN","SUPERSEDED"]},
    "title_cn":{"type":["string","null"]},
    "title_en":{"type":["string","null"]},
    "expected_state":{},
    "observed_state":{},
    "difference_summary":{"type":["string","null"]},
    "policy_evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "observed_evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "first_observed_at":{"type":["string","null"]},
    "last_verified_at":{"type":["string","null"]},
    "updated_at":{"type":"string"},
    "confidence":{"enum":["HIGH","MEDIUM","LOW","UNVERIFIED"]},
    "persistence_status":{"enum":["NOT_TESTED","TRANSIENT","REPEATED","PERSISTENT","UNKNOWN"]},
    "alternative_explanation_status":{"enum":["NOT_REVIEWED","REVIEWED_NO_BETTER_EXPLANATION","BETTER_EXPLANATION_FOUND","INCONCLUSIVE"]},
    "policy_allowed":{"enum":["YES","NO","CONDITIONAL","UNKNOWN"]},
    "technically_possible":{"enum":["YES","NO","UNKNOWN"]},
    "not_currently_punished":{"enum":["YES","NO","UNKNOWN"]},
    "long_term_sustainable":{"enum":["YES","NO","UNCERTAIN","UNKNOWN"]},
    "affected_product_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "agent12_event_ref":{"type":["string","null"]},
    "sandbox_run_ref":{"type":["string","null"]},
    "execution_authorized":{"const":false}
  }
}
