{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompetitorKeywordQueueMessage V1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "phase", "job_id", "asin", "page_num"],
      "properties": {
        "schema_version": { "const": "CompetitorKeywordQueueMessage.v1" },
        "phase": { "const": "FETCH" },
        "job_id": { "type": "string", "format": "uuid" },
        "asin": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
        "page_num": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "phase", "job_id", "offset"],
      "properties": {
        "schema_version": { "const": "CompetitorKeywordQueueMessage.v1" },
        "phase": { "const": "CLASSIFY" },
        "job_id": { "type": "string", "format": "uuid" },
        "offset": { "type": "integer", "minimum": 0 }
      }
    }
  ]
}
