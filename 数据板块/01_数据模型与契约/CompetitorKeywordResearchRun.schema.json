{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CompetitorKeywordResearchRun.schema.json",
  "title": "Competitor Keyword Research Run V1",
  "description": "success=true describes the HTTP request only. Research is complete only when job.status is SUCCEEDED, PARTIAL, or FAILED. raw_keyword_count must be greater than or equal to unique_keyword_count. Missing source metrics remain null and must never be coerced to zero.",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "job": { "$ref": "#/$defs/ResearchJob" },
    "asins": { "type": "array", "items": { "$ref": "#/$defs/AsinResult" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/KeywordItem" } },
    "error": { "$ref": "#/$defs/Error" }
  },
  "$defs": {
    "CategoryCode": {
      "enum": [
        "own_brand",
        "competitor_alternative",
        "promotion_transaction",
        "occasion_seasonal",
        "audience",
        "scenario_use_case",
        "problem_benefit",
        "feature_attribute",
        "category_core",
        "related_general"
      ]
    },
    "NullableMetric": { "type": ["number", "null"] },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "stage": { "type": ["string", "null"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ResearchJob": {
      "type": "object",
      "required": ["job_id", "marketplace", "input_asins", "input_asin_count", "status", "raw_keyword_count", "unique_keyword_count", "duplicate_keyword_count", "created_at"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "job_name": { "type": ["string", "null"] },
        "marketplace": { "const": "US" },
        "language": { "const": "en" },
        "input_asins": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9]{10}$" } },
        "own_brands": { "type": "array", "items": { "type": "string" } },
        "input_asin_count": { "type": "integer", "minimum": 1, "maximum": 10 },
        "period_start": { "type": "string", "format": "date" },
        "granularity": { "enum": ["day", "week", "month"] },
        "status": { "enum": ["QUEUED", "RUNNING", "CLASSIFICATION_PENDING", "CLASSIFYING", "SUCCEEDED", "PARTIAL", "FAILED"] },
        "raw_keyword_count": { "type": "integer", "minimum": 0 },
        "unique_keyword_count": { "type": "integer", "minimum": 0 },
        "duplicate_keyword_count": { "type": "integer", "minimum": 0 },
        "classified_keyword_count": { "type": "integer", "minimum": 0 },
        "successful_asin_count": { "type": "integer", "minimum": 0 },
        "failed_asin_count": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "object" } },
        "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Error" }] },
        "observed_at": { "type": ["string", "null"] },
        "created_at": { "type": "string" },
        "completed_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "AsinResult": {
      "type": "object",
      "required": ["asin", "status", "fetched_keyword_count", "fetched_page_count", "is_truncated"],
      "properties": {
        "asin": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
        "status": { "enum": ["QUEUED", "FETCHING", "RETRYING", "SUCCEEDED", "FAILED"] },
        "title": { "type": ["string", "null"] },
        "brand": { "type": ["string", "null"] },
        "image_url": { "type": ["string", "null"] },
        "expected_keyword_count": { "type": ["integer", "null"], "minimum": 0 },
        "fetched_keyword_count": { "type": "integer", "minimum": 0 },
        "fetched_page_count": { "type": "integer", "minimum": 0 },
        "is_truncated": { "type": "boolean" },
        "data_notice": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"] },
        "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Error" }] }
      },
      "additionalProperties": false
    },
    "KeywordItem": {
      "type": "object",
      "description": "source_asin_count must equal the number of unique values in source_asins.",
      "required": ["keyword_id", "keyword", "normalized_keyword", "primary_category", "query_shape", "strategic_tier", "relevance_status", "needs_review", "source_asin_count", "source_asins"],
      "properties": {
        "keyword_id": { "type": "string" },
        "keyword": { "type": "string", "minLength": 1 },
        "normalized_keyword": { "type": "string", "minLength": 1 },
        "primary_category": { "$ref": "#/$defs/CategoryCode" },
        "secondary_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "matched_facets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "classification_reason": { "type": "string" },
        "classification_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "query_shape": { "enum": ["HEAD", "MID_TAIL", "LONG_TAIL"] },
        "strategic_tier": { "enum": ["CORE", "SUPPORT", "LONG_TAIL", "NICHE"] },
        "relevance_status": { "enum": ["RELEVANT", "AMBIGUOUS", "IRRELEVANT"] },
        "needs_review": { "type": "boolean" },
        "source_asin_count": { "type": "integer", "minimum": 1 },
        "source_asins": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9]{10}$" } },
        "search_volume": { "$ref": "#/$defs/NullableMetric" },
        "best_aba_rank": { "type": ["integer", "null"] },
        "max_traffic_score": { "$ref": "#/$defs/NullableMetric" },
        "max_traffic_share": { "$ref": "#/$defs/NullableMetric" },
        "best_organic_rank": { "$ref": "#/$defs/NullableMetric" },
        "best_sp_rank": { "$ref": "#/$defs/NullableMetric" },
        "near_duplicate_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
