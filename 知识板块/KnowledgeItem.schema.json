{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://1122.local/schemas/KnowledgeItem.schema.json",
  "title":"KnowledgeItem",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "knowledge_id","knowledge_type","domain","title","summary","content",
    "truth_class","confidence","source_refs","version","status",
    "execution_authorized"
  ],
  "properties":{
    "knowledge_id":{"type":"string","pattern":"^KB-[A-Z]{2,5}-[0-9]{4}$"},
    "knowledge_type":{"type":"string","enum":[
      "POLICY","OPERATING_METHOD","MARKET_PATTERN","PRODUCT_KNOWLEDGE",
      "ADVERTISING_KNOWLEDGE","PRICING_KNOWLEDGE","CONTENT_KNOWLEDGE",
      "CASE_LESSON","SYSTEM_ENGINEERING","DATA_DEFINITION","DECISION_RULE"
    ]},
    "domain":{"type":"string","minLength":1},
    "subdomain":{"type":["string","null"]},
    "marketplace":{"type":["string","null"]},
    "title":{"type":"string","minLength":1},
    "summary":{"type":"string","minLength":1},
    "content":{"type":"string","minLength":1},
    "keywords":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "applicable_conditions":{"type":"array","items":{"type":"string"}},
    "not_applicable_conditions":{"type":"array","items":{"type":"string"}},
    "related_product_refs":{"type":"array","items":{"type":"string"}},
    "related_knowledge_refs":{"type":"array","items":{"type":"string"}},
    "source_refs":{"type":"array","items":{"type":"string"}},
    "source_urls":{"type":"array","items":{"type":"string","format":"uri"}},
    "truth_class":{"type":"string","enum":[
      "SOURCE_ONLY","OBSERVED","DERIVED","VALIDATED","CONFIRMED","CONFLICTING","UNKNOWN"
    ]},
    "confidence":{"type":"string","enum":["HIGH","MEDIUM","LOW","UNVERIFIED"]},
    "freshness_status":{"type":"string","enum":["FRESH","LAGGED","STALE","UNKNOWN"]},
    "effective_at":{"type":["string","null"]},
    "last_verified_at":{"type":["string","null"]},
    "version":{"type":"integer","minimum":1},
    "status":{"type":"string","enum":["ACTIVE","DRAFT","SUPERSEDED","ARCHIVED"]},
    "ui_visibility":{"type":"boolean","default":true},
    "execution_authorized":{"const":false},
    "production_write_authorized":{"const":false}
  }
}
