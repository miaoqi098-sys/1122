{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Action V1.0",
  "type":"object",
  "required":["schema_version","action_id","task_id","actor_type","action_type","executed_at"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "action_id":{"type":"string","minLength":1},
    "task_id":{"type":"string","minLength":1},
    "product_id":{"type":["string","null"]},
    "event_id":{"type":["string","null"]},
    "decision_id":{"type":["string","null"]},
    "goal_id":{"type":["string","null"]},
    "actor_type":{"enum":["agent","human","system","external"]},
    "actor_id":{"type":["string","null"]},
    "action_type":{"type":"string","minLength":1},
    "target_type":{"type":["string","null"]},
    "target_id":{"type":["string","null"]},
    "before_value":{"type":["object","array","string","number","boolean","null"]},
    "requested_value":{"type":["object","array","string","number","boolean","null"]},
    "applied_value":{"type":["object","array","string","number","boolean","null"]},
    "business_reason":{"type":["string","null"]},
    "approval_id":{"type":["string","null"]},
    "execution_result_id":{"type":["string","null"]},
    "validation_status":{"enum":["not_started","pending","passed","failed","inconclusive"]},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "executed_at":{"type":"string","format":"date-time"},
    "metadata":{"type":"object"}
  },
  "additionalProperties":false
}