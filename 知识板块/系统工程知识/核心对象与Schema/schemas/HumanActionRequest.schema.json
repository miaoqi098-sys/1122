{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"HumanActionRequest V1.0",
  "type":"object",
  "required":["schema_version","human_action_request_id","task_id","reason_code","status","created_at"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "human_action_request_id":{"type":"string","minLength":1},
    "task_id":{"type":"string","minLength":1},
    "product_id":{"type":["string","null"]},
    "approval_id":{"type":["string","null"]},
    "reason_code":{"enum":["approval_required","manual_execution_required","missing_information","permission_unavailable","high_risk","low_confidence","external_platform_limit","business_decision_required","other"]},
    "status":{"enum":["open","in_progress","resolved","cancelled","expired"]},
    "summary":{"type":"string"},
    "why_human_required":{"type":"string"},
    "agent_recommendation":{"type":["string","null"]},
    "risk_summary":{"type":["string","null"]},
    "requested_actions":{"type":"array","items":{"type":"string"}},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "deadline":{"type":["string","null"],"format":"date-time"},
    "created_at":{"type":"string","format":"date-time"},
    "resolved_at":{"type":["string","null"],"format":"date-time"},
    "resolved_by_actor_id":{"type":["string","null"]},
    "resolution_note":{"type":["string","null"]},
    "metadata":{"type":"object"}
  },
  "additionalProperties":false
}