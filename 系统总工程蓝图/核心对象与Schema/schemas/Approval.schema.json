{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Approval V1.0",
  "type":"object",
  "required":["schema_version","approval_id","task_id","status","requested_at"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "approval_id":{"type":"string","minLength":1},
    "task_id":{"type":"string","minLength":1},
    "product_id":{"type":["string","null"]},
    "decision_id":{"type":["string","null"]},
    "policy_refs":{"type":"array","items":{"type":"string"}},
    "permission_refs":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["requested","approved","rejected","expired","cancelled"]},
    "requested_by_actor_type":{"enum":["agent","human","system"]},
    "requested_by_actor_id":{"type":["string","null"]},
    "approver_actor_type":{"enum":["human","system","unassigned"]},
    "approver_actor_id":{"type":["string","null"]},
    "reason":{"type":["string","null"]},
    "risk_summary":{"type":["string","null"]},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "requested_at":{"type":"string","format":"date-time"},
    "decided_at":{"type":["string","null"],"format":"date-time"},
    "expires_at":{"type":["string","null"],"format":"date-time"},
    "decision_note":{"type":["string","null"]},
    "metadata":{"type":"object"}
  },
  "additionalProperties":false
}