{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task V1.0",
  "type": "object",
  "required": ["schema_version","task_id","task_type","status","created_at","updated_at"],
  "properties": {
    "schema_version":{"const":"1.0"},
    "task_id":{"type":"string","minLength":1},
    "task_plan_id":{"type":["string","null"]},
    "product_id":{"type":["string","null"]},
    "event_id":{"type":["string","null"]},
    "decision_id":{"type":["string","null"]},
    "decision_item_id":{"type":["string","null"]},
    "goal_id":{"type":["string","null"]},
    "task_type":{"enum":["execution","monitoring","approval","data_collection","validation","control","rollback","human_action"]},
    "status":{"enum":["created","pending_approval","ready","running","blocked","failed","cancelled","awaiting_validation","completed","rolled_back","waiting_human","waiting_external","expired"]},
    "priority":{"enum":["P0","P1","P2","P3","unknown"]},
    "summary":{"type":"string"},
    "business_reason":{"type":["string","null"]},
    "owner_actor_type":{"enum":["agent","human","system","external","unassigned"]},
    "owner_actor_id":{"type":["string","null"]},
    "executor_ref":{"type":["string","null"]},
    "approver_ref":{"type":["string","null"]},
    "validator_ref":{"type":["string","null"]},
    "dependency_task_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "requires_human":{"type":"boolean"},
    "approval_id":{"type":["string","null"]},
    "human_action_request_id":{"type":["string","null"]},
    "deadline":{"type":["string","null"],"format":"date-time"},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "metadata":{"type":"object"}
  },
  "additionalProperties":false
}