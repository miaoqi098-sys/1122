{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DailyOperatingBrief.v2",
  "type": "object",
  "required": [
    "brief_id",
    "date",
    "marketplace",
    "data_status",
    "strategy_context",
    "overall_status",
    "metrics",
    "signals",
    "root_cause_assessments",
    "actions",
    "tasks",
    "action_validation",
    "stage_review"
  ],
  "properties": {
    "brief_id": {
      "type": "string",
      "minLength": 6
    },
    "version": {
      "type": "string",
      "default": "2.0"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "marketplace": {
      "type": "string"
    },
    "seller_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "asin_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "promotion_plan_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "data_status": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "DATA_READY",
            "DATA_DELAYED",
            "DATA_INCOMPLETE",
            "DATA_CONFLICT"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "status"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "last_success_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "freshness": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "strategy_context": {
      "type": "object",
      "required": [
        "current_stage",
        "stage_confidence",
        "primary_constraint",
        "primary_goal"
      ],
      "properties": {
        "current_stage": {
          "type": "string"
        },
        "stage_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "primary_constraint": {
          "type": "string"
        },
        "constraint_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "primary_goal": {
          "type": "string"
        },
        "current_strategy": {
          "type": [
            "string",
            "null"
          ]
        },
        "avoid_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transition_candidate": {
          "type": [
            "string",
            "null"
          ]
        },
        "regression_candidate": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "GREEN",
        "YELLOW",
        "RED"
      ]
    },
    "today_focus": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metricWindow"
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_id",
          "signal_type",
          "severity",
          "fact",
          "evidence_window"
        ],
        "properties": {
          "signal_id": {
            "type": "string"
          },
          "signal_type": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "asin": {
            "type": [
              "string",
              "null"
            ]
          },
          "fact": {
            "type": "string"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "evidence_window": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_goal": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage_relevance": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "OBSERVING",
              "CONVERTED_TO_DECISION",
              "RESOLVED",
              "DISMISSED"
            ]
          }
        }
      }
    },
    "root_cause_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_id",
          "status"
        ],
        "properties": {
          "signal_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "RESOLVED",
              "UNRESOLVED",
              "NEEDS_DATA"
            ]
          },
          "primary_root_cause": {
            "type": [
              "string",
              "null"
            ]
          },
          "root_cause_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cause": {
                  "type": "string"
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "supporting_evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "contradicting_evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "missing_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "priority",
          "description",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "source_signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_item_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_result": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_required": {
            "type": "boolean",
            "default": false
          },
          "approval_level": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              null
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_APPROVAL",
              "APPROVED",
              "IN_PROGRESS",
              "DONE",
              "BLOCKED",
              "CANCELLED"
            ]
          }
        }
      }
    },
    "action_validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "validation_status"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "baseline": {
            "type": {}
          },
          "executed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expected_result": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_result": {
            "type": [
              "string",
              "null"
            ]
          },
          "observation_window": {
            "type": [
              "string",
              "null"
            ]
          },
          "guardrail": {
            "type": [
              "string",
              "null"
            ]
          },
          "rollback_condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "validation_status": {
            "type": "string",
            "enum": [
              "PENDING",
              "POSITIVE",
              "NEUTRAL",
              "NEGATIVE",
              "INSUFFICIENT_DATA",
              "SIDE_EFFECT_DETECTED"
            ]
          },
          "next_step": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stage_review": {
      "type": "object",
      "required": [
        "transition_candidate",
        "regression_candidate",
        "constraint_changed",
        "strategy_refresh_required"
      ],
      "properties": {
        "transition_candidate": {
          "type": [
            "string",
            "null"
          ]
        },
        "regression_candidate": {
          "type": [
            "string",
            "null"
          ]
        },
        "constraint_changed": {
          "type": "boolean"
        },
        "new_primary_constraint": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy_refresh_required": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "change_collision_check": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "CLEAR",
            "WARNING",
            "BLOCKED"
          ]
        },
        "recent_major_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "metricWindow": {
      "type": "object",
      "properties": {
        "current": {},
        "d1": {},
        "d3": {},
        "d7": {},
        "d14": {},
        "d30": {},
        "delta_vs_d7": {},
        "delta_vs_d14": {},
        "target": {},
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "required": [
        "action_id",
        "action_type",
        "action",
        "why",
        "approval_level"
      ],
      "properties": {
        "action_id": {
          "type": "string"
        },
        "action_type": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation_window": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "avoid_if": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cooldown_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "approval_level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        },
        "decision_item_required": {
          "type": "boolean",
          "default": false
        },
        "status": {
          "type": "string",
          "enum": [
            "SUGGESTED",
            "OBSERVING",
            "PENDING_APPROVAL",
            "APPROVED",
            "EXECUTED",
            "REJECTED",
            "CANCELLED"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}